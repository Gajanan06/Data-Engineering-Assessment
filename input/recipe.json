[
  {
    "recipe_id": "r_curd_rice_0001",
    "title": "Curd Rice",
    "description": "Comforting curd rice for two — mildly seasoned with tempered onion, cumin and coriander.",
    "cuisine": "Indian",
    "difficulty": "easy",
    "prep_time_minutes": 10,
    "cook_time_minutes": 15,
    "total_time_minutes": 25,
    "servings": 2,
    "tags": ["comfort","vegetarian","south_indian"],
    "ingredients": [
      {"name":"rice","quantity":2,"unit":"bowl"},
      {"name":"curd (yogurt)","quantity":2,"unit":"bowl"},
      {"name":"coriander leaves","quantity":1,"unit":"bowl"},
      {"name":"oil","quantity":3,"unit":"tsp"},
      {"name":"salt","quantity":1,"unit":"tsp"},
      {"name":"jeera (cumin seeds)","quantity":1,"unit":"tsp"},
      {"name":"water","quantity":2,"unit":"litre"},
      {"name":"onion (chopped)","quantity":0.5,"unit":"unit"}
    ],
    "steps": [
      {"step_no":1,"text":"Keep all ingredients ready."},
      {"step_no":2,"text":"Wash the rice: put rice in a vessel, add water, mix and drain until water is clear."},
      {"step_no":3,"text":"Add rinsed rice to vessel with ~1 litre water and 1 tsp oil. Cover and cook/steam for 10-15 minutes until rice is cooked."},
      {"step_no":4,"text":"Remove cooked rice and keep aside."},
      {"step_no":5,"text":"Heat a pan on gas."},
      {"step_no":6,"text":"Add 2 tsp oil to pan and heat."},
      {"step_no":7,"text":"Add chopped onion, 1 tsp jeera and 1 tsp salt; sauté for 2-3 minutes."},
      {"step_no":8,"text":"Add curd (2 bowls) to the pan and mix well."},
      {"step_no":9,"text":"Add the steamed rice to the pan; mix thoroughly with a spoon."},
      {"step_no":10,"text":"Transfer curd rice to a big bowl and add chopped coriander leaves on top."},
      {"step_no":11,"text":"Serve warm."}
    ],
    "created_at":"2025-11-19T00:00:00Z",
    "created_by":"user_gajanan"
  },
